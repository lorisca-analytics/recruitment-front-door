{
  "name": "recruitment-front-door",
  "version": "1.0.0",
  "private": true,
  "description": "A standardized intake gate and mass interview engine on Google Sheets and Apps Script. Rebuilt from scratch with synthetic data.",
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "seed": "tsx scripts/seed.ts",
    "card:sample": "tsx scripts/render-sample-card.ts",
    "demo:build": "node scripts/build-demo.mjs",
    "push": "npm run build && clasp push",
    "demo:record": "tsx scripts/record-demo.ts",
    "before-after": "tsx scripts/before-after.ts"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.83",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.6.5",
    "esbuild": "^0.23.1",
    "jest": "^29.7.0",
    "playwright-core": "^1.56.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
